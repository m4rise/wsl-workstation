#!/usr/bin/env bash
#MISE description="Capture selected identity, SSH key, and optional KDBX"
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=scripts/capabilities.sh
source "$repo_root/scripts/capabilities.sh"
workstation_require secrets
exec python3 "$repo_root/scripts/secrets.py" capture "$@"
