#!/usr/bin/env bash
#MISE description="Restore personal files explicitly from a private bundle"
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=scripts/capabilities.sh
source "$repo_root/scripts/capabilities.sh"
workstation_require secrets
exec python3 "$repo_root/scripts/secrets.py" restore "$@"
