#!/usr/bin/env bash
#MISE description="Atomically update the bundled KeePassXC vault with a private backup"
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=scripts/capabilities.sh
source "$repo_root/scripts/capabilities.sh"
workstation_require secrets
workstation_require vault
exec python3 "$repo_root/scripts/secrets.py" vault-update "$@"
